{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js",
    "build": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js build",
    "preview": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js preview",
    "lint": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/eslint/bin/eslint.js . --fix",
    "typecheck": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.app.json && node --preserve-symlinks --preserve-symlinks-main ./node_modules/typescript/lib/tsc.js -p tsconfig.app.json",
    "test": "node --preserve-symlinks --preserve-symlinks-main --experimental-strip-types run-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
