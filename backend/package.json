{
  "name": "mentorai-backend",
  "version": "1.0.0",
  "description": "MentorAI AI-Powered Interactive Assessment Platform Backend",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "node --preserve-symlinks --preserve-symlinks-main src/index.ts",
    "build": "node --preserve-symlinks --preserve-symlinks-main -e \"require('./node_modules/typescript/lib/tsc.js')\"",
    "start": "node --preserve-symlinks --preserve-symlinks-main dist/src/index.js",
    "lint": "node --preserve-symlinks --preserve-symlinks-main -e \"require('./node_modules/eslint/bin/eslint.js')\" -- src tests",
    "lint:fix": "node --preserve-symlinks --preserve-symlinks-main -e \"require('./node_modules/eslint/bin/eslint.js')\" -- src tests --fix",
    "typecheck": "node --preserve-symlinks --preserve-symlinks-main -e \"require('./node_modules/typescript/lib/tsc.js')\" -- --noEmit",
    "test": "node --preserve-symlinks --preserve-symlinks-main run-tests.mjs",
    "db:generate": "node --preserve-symlinks --preserve-symlinks-main -e \"require('./node_modules/drizzle-kit/bin.cjs')\" generate",
    "db:push": "node --preserve-symlinks --preserve-symlinks-main -e \"require('./node_modules/drizzle-kit/bin.cjs')\" push",
    "db:seed": "node --preserve-symlinks --preserve-symlinks-main dist/src/db/seed.js"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.4.3",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.8",
    "p-queue": "^8.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.7"
  }
}
